{
  "name": "drift",
  "version": "v0.1.0",
  "main": "src/cli.ts",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "drift": "bun run ./src/cli",
    "build:windows": "bun build --compile --target=bun-windows-x64 ./src/cli.ts --outfile ./dist/drift-windows-x64",
    "build:linux": "bun build --compile --target=bun-linux-x64 ./src/cli.ts --outfile ./dist/drift-linux-x64",
    "build:darwin": "bun build --compile --target=bun-darwin-x64 ./src/cli.ts --outfile ./dist/drift-darwin-x64",
    "build:darwin:arm": "bun build --compile --target=bun-darwin-arm64 ./src/cli.ts --outfile ./dist/drift-darwin-arm64",
    "build": "bun run build:windows && bun run build:linux && bun run build:darwin && bun run build:darwin:arm",
    "clean:dist": "rm -rf ./dist/*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
